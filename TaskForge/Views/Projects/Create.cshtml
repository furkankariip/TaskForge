@model TaskForge.Models.Project

@{
    ViewData["Title"] = "Yeni Proje";
}

<div class="form-page">

    <div class="form-page-header">
        <a asp-action="Index" class="back-link">
            ← Projelere Dön
        </a>

        <h1>Yeni Proje Oluştur</h1>
        <p>Yeni projenin temel bilgilerini ve planlamasını belirle.</p>
    </div>


    <div class="form-card">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>


            <!-- GENEL BİLGİLER -->

            <div class="form-section">

                <div class="section-title">
                    <div class="section-icon">▣</div>

                    <div>
                        <h3>Proje Bilgileri</h3>
                        <p>Projenin temel bilgilerini gir.</p>
                    </div>
                </div>


                <div class="mb-4">

                    <label asp-for="Name"
                           class="form-label">
                        Proje Adı
                    </label>

                    <input asp-for="Name"
                           class="form-control custom-input"
                           placeholder="Örn: TaskForge" />

                    <span asp-validation-for="Name"
                          class="text-danger validation-text">
                    </span>

                </div>


                <div class="mb-2">

                    <label asp-for="Description"
                           class="form-label">
                        Açıklama
                    </label>

                    <textarea asp-for="Description"
                              class="form-control custom-input"
                              rows="5"
                              placeholder="Projenin amacını ve kapsamını kısaca açıkla...">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger validation-text">
                    </span>

                </div>

            </div>


            <!-- PLANLAMA -->

            <div class="form-section">

                <div class="section-title">

                    <div class="section-icon">
                        ◷
                    </div>

                    <div>
                        <h3>Planlama</h3>
                        <p>Tarih, durum ve öncelik bilgilerini belirle.</p>
                    </div>

                </div>


                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label">
                            Başlangıç Tarihi
                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control custom-input" />

                        <span asp-validation-for="StartDate"
                              class="text-danger validation-text">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="DueDate"
                               class="form-label">
                            Bitiş Tarihi
                        </label>

                        <input asp-for="DueDate"
                               type="date"
                               class="form-control custom-input" />

                        <span asp-validation-for="DueDate"
                              class="text-danger validation-text">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="Status"
                               class="form-label">
                            Durum
                        </label>

                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<TaskForge.Models.ProjectStatus>()"
                                class="form-select custom-input">
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger validation-text">
                        </span>

                    </div>


                    <div class="col-md-6">

                        <label asp-for="ProjectPriority"
                               class="form-label">
                            Öncelik
                        </label>

                        <select asp-for="ProjectPriority"
                                asp-items="Html.GetEnumSelectList<TaskForge.Models.ProjectPriority>()"
                                class="form-select custom-input">
                        </select>

                        <span asp-validation-for="ProjectPriority"
                              class="text-danger validation-text">
                        </span>

                    </div>

                </div>

            </div>


            <!-- BUTTONS -->

            <div class="form-actions">

                <a asp-action="Index"
                   class="btn-cancel">
                    Vazgeç
                </a>

                <button type="submit"
                        class="btn-save">
                    Projeyi Oluştur
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .form-page {
        max-width: 950px;
        margin: 0 auto;
        padding-top: 10px;
    }

    .form-page-header {
        margin-bottom: 25px;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 13px;
        color: #778294;
        text-decoration: none;
        font-size: 12px;
    }

        .back-link:hover {
            color: #4f6ff5;
        }

    .form-page-header h1 {
        margin: 0 0 6px;
        color: #172033;
        font-size: 30px;
        font-weight: 750;
    }

    .form-page-header p {
        margin: 0;
        color: #7f8998;
        font-size: 13px;
    }


    /* CARD */

    .form-card {
        background: white;
        border: 1px solid #e5e9f0;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(20, 35, 65, 0.04);
        overflow: hidden;
    }


    /* SECTIONS */

    .form-section {
        padding: 28px 32px;
        border-bottom: 1px solid #edf0f4;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
    }

    .section-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 11px;
        background: #eef3ff;
        color: #4f6ff5;
        font-size: 17px;
        font-weight: 700;
    }

    .section-title h3 {
        margin: 0 0 2px;
        color: #263142;
        font-size: 15px;
        font-weight: 700;
    }

    .section-title p {
        margin: 0;
        color: #929baa;
        font-size: 11px;
    }


    /* INPUTS */

    .form-label {
        color: #465264;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .custom-input {
        min-height: 44px;
        border: 1px solid #dfe4eb;
        border-radius: 9px;
        background: #fbfcfd;
        color: #283243;
        font-size: 13px;
        padding-left: 13px;
        padding-right: 13px;
        transition: 0.2s ease;
    }

    textarea.custom-input {
        padding-top: 12px;
    }

    .custom-input:focus {
        background: white;
        border-color: #6f89f7;
        box-shadow: 0 0 0 3px rgba(79, 111, 245, 0.10);
    }

    .custom-input::placeholder {
        color: #b0b7c2;
    }

    .validation-text {
        display: block;
        margin-top: 5px;
        font-size: 10px;
    }


    /* ACTIONS */

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 20px 32px;
        background: #fafbfc;
    }

    .btn-cancel {
        padding: 10px 18px;
        border: 1px solid #dfe4eb;
        border-radius: 9px;
        background: white;
        color: #687386;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }

        .btn-cancel:hover {
            background: #f5f7fa;
            color: #263142;
        }

    .btn-save {
        padding: 10px 20px;
        border: none;
        border-radius: 9px;
        background: #4f6ff5;
        color: white;
        font-size: 12px;
        font-weight: 600;
        box-shadow: 0 5px 12px rgba(79, 111, 245, 0.18);
        transition: 0.2s;
    }

        .btn-save:hover {
            background: #405fdc;
            transform: translateY(-1px);
        }


    @@media (max-width: 700px) {

        .form-section {
            padding: 22px 20px;
        }

        .form-actions {
            padding: 18px 20px;
        }
    }

</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}